# HUD — Openbox theme. Palette taken from eDEX-UI's "tron" theme.
#   cyan  #aacfd1   ink  #05080d   line  #262828   dim  #4f6566

border.width: 1
padding.width: 8
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0

window.active.border.color: #aacfd1
window.inactive.border.color: #262828
window.active.client.color: #05080d
window.inactive.client.color: #05080d

window.active.title.bg: flat solid
